model User {
  id String @id @default(uuid())

  firstName String
  lastName  String?

  email    String @unique
  password String

  phone String?

  status UserStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  userRoles UserRole[]

  student Student?
  teacher Teacher?

  createdNotices Notice[] @relation("NoticeCreatedBy")
}