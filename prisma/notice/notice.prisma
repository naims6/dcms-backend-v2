enum NoticeCategory {
  GENERAL
  SCHOLARSHIP
  JOB
  RESULT
}

enum NoticeStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model Notice {
  id          String         @id @default(cuid())
  category    NoticeCategory
  subject     String         @db.VarChar(500)
  body        String         @db.Text
  noticeDate  DateTime
  status      NoticeStatus   @default(DRAFT)
  publishedAt DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([category])
  @@index([status])
  @@index([noticeDate])
  @@index([createdAt])
}